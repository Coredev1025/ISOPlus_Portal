PORT=YOUR_BACKEND_PORT

MONGODB_URI=YOUR_MONGODB_URI

JWT_SECRET=YOUR_KWT_SECRET

XERO_CLIENT_ID=YOUR_XERO_CLINET_ID
XERO_CLIENT_SECRET=YOUR_XERO_CLIENT_SECRET
XERO_REDIRECT_URL=${YOUR_DOMAIN}/api/xero/callback

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=YOUR_AWS_REGION
AWS_BUCKET=YOUR_AWS_BUCKET
AWS_BUCKET_PUBLIC=YOUR_AWS_BUCKET_PUBLIC

# ISO+ OAuth. Needed for the ISO+ button on the login screen; with CLIENT_ID
# blank that button produces an "unsupported_grant_type" error page, because the
# authorize URL is built with an empty client_id.
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET

# The bearer that support_admin / owner sessions use for every ISO+ API call
# (middleware/authHelpers.js). Blank means GET /api/workspaces returns nothing,
# because that endpoint proxies ISO+ rather than reading MongoDB.
# Leave blank to run offline — see ISOPLUS_OFFLINE below.
PERSONAL_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN

# Serve ISO+ workspaces and boards from MongoDB instead of proxying ISO+, so the
# local stack works without credentials. Unset it and the mode turns itself on
# whenever PERSONAL_ACCESS_TOKEN is blank and NODE_ENV is not production.
#   1  force on    0  force off (reproduce the real "no credentials" failure)
# Never applies in production: there, a blank token must fail loudly.
ISOPLUS_OFFLINE=

# Public origin of THIS backend, used to build the URLs written into ISO+ —
# board automation webhooks (utils/automationUrlUpdate.js) and the sync hook
# callback (utils/webhookServiceHelpers.js). Both degrade silently when it is
# unset: the automation rewrite warns and changes nothing, and hook registration
# falls back to http://localhost:3001 while still reporting success.
# Set it to an ngrok URL to point a live ISO+ board at your local backend.
BACKEND_URL=
AUTHORIZATION_ENDPOINT=https://app.isoplus.online/oauth/authorize
TOKEN_ENDPOINT=https://app.isoplus.online/oauth/token
USER_INFORMATION_ENDPOINT=https://app.isoplus.online/api/v2/profile
CALLBACK_URL=${YOUR_DOMAIN}/api/auth/isoplus/callback
REDIRECT_URL=/api/auth/isoplus/profile
HTTPS_URL=YOUR_DOMAIN

FRONTEND_URL=http://localhost:3000

ALLOWED_ORIGINS=YOUR_ALLOWED_URL

SESSION_SECRET=YOUR_SESSION_SECRET
Admin_API_Key=YOUR_ADMIN_SECRET_API_KEY

# Guards POST /api/scheduler/tick (the EventBridge-driven scheduler endpoint).
# Deliberately separate from Admin_API_Key so the two rotate independently —
# see docs/scheduling.md.
SCHEDULER_API_KEY=YOUR_SCHEDULER_SECRET_API_KEY

# Sentry error/log reporting (leave blank to disable).
# Use the DSN from Sentry → Project Settings → Client Keys (DSN).
# Required for auth login logs (Sentry.logger) and Express error capture.
SENTRY_DSN=YOUR_SENTRY_DSN
