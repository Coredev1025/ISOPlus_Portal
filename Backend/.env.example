PORT=YOUR_BACKEND_PORT

MONGODB_URI=YOUR_MONGODB_URI

JWT_SECRET=YOUR_KWT_SECRET

XERO_CLIENT_ID=YOUR_XERO_CLINET_ID
XERO_CLIENT_SECRET=YOUR_XERO_CLIENT_SECRET
XERO_REDIRECT_URL=${YOUR_DOMAIN}/api/xero/callback

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=YOUR_AWS_REGION
AWS_BUCKET=YOUR_AWS_BUCKET
AWS_BUCKET_PUBLIC=YOUR_AWS_BUCKET_PUBLIC

# ISO+ OAuth. Needed for the ISO+ button on the login screen; with CLIENT_ID
# blank that button produces an "unsupported_grant_type" error page, because the
# authorize URL is built with an empty client_id.
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET

# The bearer that support_admin / owner sessions use for every ISO+ API call
# (middleware/authHelpers.js). Blank means GET /api/workspaces returns nothing,
# because that endpoint proxies ISO+ rather than reading MongoDB.
# Leave blank to run offline — see ISOPLUS_OFFLINE below.
PERSONAL_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN

# Serve ISO+ workspaces and boards from MongoDB instead of proxying ISO+, so the
# local stack works without credentials. Unset it and the mode turns itself on
# whenever PERSONAL_ACCESS_TOKEN is blank and NODE_ENV is not production.
#   1  force on    0  force off (reproduce the real "no credentials" failure)
# Never applies in production: there, a blank token must fail loudly.
# Also skips the scheduler's board_sync handler (npm run tick), so a local
# schedule never dispatches a real sync against app.isoplus.online.
# NEVER set this in a deployed environment, on any value: the skipped
# board_sync is recorded as a SUCCESS, so the tick reports the job dispatched,
# advances nextRunAt and leaves consecutiveFailures at zero. Monitoring sees a
# perfectly healthy scheduler while nothing is syncing.
ISOPLUS_OFFLINE=

# Public origin of THIS backend, used to build the URLs written into ISO+ —
# board automation webhooks (utils/automationUrlUpdate.js) and the sync hook
# callback (utils/webhookServiceHelpers.js). Both degrade silently when it is
# unset: the automation rewrite warns and changes nothing, and hook registration
# falls back to http://localhost:3001 while still reporting success.
# Set it to an ngrok URL to point a live ISO+ board at your local backend.
BACKEND_URL=
AUTHORIZATION_ENDPOINT=https://app.isoplus.online/oauth/authorize
TOKEN_ENDPOINT=https://app.isoplus.online/oauth/token
USER_INFORMATION_ENDPOINT=https://app.isoplus.online/api/v2/profile
CALLBACK_URL=${YOUR_DOMAIN}/api/auth/isoplus/callback
REDIRECT_URL=/api/auth/isoplus/profile
HTTPS_URL=YOUR_DOMAIN

FRONTEND_URL=http://localhost:3000

ALLOWED_ORIGINS=YOUR_ALLOWED_URL

SESSION_SECRET=YOUR_SESSION_SECRET
Admin_API_Key=YOUR_ADMIN_SECRET_API_KEY

# Guards POST /api/scheduler/tick (the EventBridge-driven scheduler endpoint).
# Deliberately separate from Admin_API_Key so the two rotate independently —
# see docs/scheduling.md.
SCHEDULER_API_KEY=YOUR_SCHEDULER_SECRET_API_KEY

# Optional per-kind tick credentials, one per EventBridge rule. The presented
# key IS the scope: a tick sent with the invoice key claims only
# invoice_automation schedules, the statement key only statement_automation.
# Leave unset if a single rule (the master key above) fires everything.
# SCHEDULER_API_KEY_INVOICE=
# SCHEDULER_API_KEY_STATEMENT=

# Cron for the portal-wide ISO+ board catch-up (in-process setTimeout +
# cron-parser, not EventBridge). Default if unset: 0 2 * * * (02:00
# Australia/Sydney). Invalid expressions refuse to start the timer at boot
# (warn + skip). Without this variable the default still runs; set it to
# change cadence.
#
# After deploy, disable leftover EventBridge-era schedule rows once:
#   npm run migrate -- up disable-portal-board-sync-schedule
# (add --allow-remote outside local Mongo). Migrations do not run on boot.
BOARD_SYNC_CRON=

# Master switch for the portal scheduled catch-up only (cron + sweep). Unset or
# blank = on. Set to false / 0 / off / no to stop the timer and make sweeps a
# no-op. Per-board Sync checkbox, ISO+ webhooks, and manual Resync are
# unaffected.
#
# Env is read at process start: changing this requires a restart. Turning it
# off does not cancel delayed or waiting scheduled_sync jobs already in Redis
# from a prior sweep — drain Bull Board / wait them out, or remove those jobs
# before relying on "off".
BOARD_SYNC_ENABLED=

# Minimum delay in ms between starts of consecutive scheduled_sync jobs in one
# sweep (BullMQ job delay = index * gap). Default 0 = back-to-back. Raise this
# (e.g. 60000) to reduce ISO+ 429 risk between boards. If a board takes longer
# than the gap, the next job may already be eligible and start immediately —
# this is minimum start spacing, not a post-completion cool-down. For a real
# rest after each board, set the gap >= typical board sync duration. Manual
# Resync is not delayed (higher BullMQ priority, no delay). Delayed jobs are
# still stamped on the board at enqueue (Queued / scheduled_sync) until they
# run or an operator Resync removes a waiting/delayed catch-up.
BOARD_SYNC_GAP_MS=

# Sentry error/log reporting (leave blank to disable).
# Use the DSN from Sentry → Project Settings → Client Keys (DSN).
# Required for auth login logs (Sentry.logger) and Express error capture.
SENTRY_DSN=YOUR_SENTRY_DSN

# Master switch for the invoice/statement automation pipeline. Off unless it is
# exactly one of: true, 1, yes, on (case-insensitive). Unset, blank, "false" and
# anything unrecognised all mean OFF — guessing wrong in the permissive
# direction consumes a customer's invoice numbers.
#
# The pipeline generates real PDFs, claims real invoice numbers off
# Business.documentNumbering and writes real S3 objects. Turn it on only where
# the email transport below is also configured: the worker refuses to generate
# when it cannot deliver, but the safe state for an environment that is not
# meant to send is both switches off.
#
# Read by services/scheduler/tick.js BEFORE a schedule is claimed: off means the
# automation kinds are held back, so each due slot STAYS due and is billed when
# the switch comes on. It used to be read only at dispatch, where returning
# early counts as success and advanced nextRunAt past the slot — a deployment
# that spent three months switched off consumed three billing periods and
# generated nothing for any of them.
#
# Only the oldest held slot fires when the switch comes on: the advance jumps
# straight past the rest and counts them in missedRuns, so turning it on does
# not replay a backlog. The tick summary reports `heldBack` while it is off.
AUTOMATION_ENABLED=

# AWS SES delivery (services/email/sesTransport.js), via the SESv2 SDK using
# the same AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION the app
# already uses for S3 — there is no SMTP credential and none is needed.
#
# EMAIL_FROM is both the default From address and the deliberate opt-in: email
# delivery is DISABLED while it (or any of the AWS variables) is empty, because
# the caller uses that to decide whether to generate invoices at all. Only the
# sending identity's domain is verified in SES — dev.isoplus.online in dev —
# so the address must be on that domain (e.g. noreply@dev.isoplus.online).
#
# Dev guardrail: the dev IAM key may only send to recipients at
# isoconsultingservices.com.au, isoplus.online and simulator.amazonses.com;
# anything else returns AccessDenied, which the SES backend records as a
# refusal rather than retrying. Test with the SES simulator addresses
# (success@/bounce@/complaint@simulator.amazonses.com) — never real ones: the
# suppression list is account-wide and shared with production.
EMAIL_FROM=

# SQS queue where SES publishes sending events (Delivery, Bounce, Complaint,
# DeliveryDelay, Reject, Rendering Failure), polled by
# workers/emailEventsWorker.js with the same AWS credential. Leave empty to
# not start the consumer at all — nothing else changes.
SES_EVENTS_QUEUE_URL=
