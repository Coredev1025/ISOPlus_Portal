# Optional. Copy to `.env` in this directory to change what docker-compose.yml
# publishes and which database it targets. The defaults below are already
# applied when no .env exists.
#
# App secrets do NOT go here — they live in Backend/.env and Frontend/.env.local.
#
# scripts/worktree.sh writes this file automatically for new worktrees, picking
# free ports and a distinct project name. You only need to edit it by hand in
# the main clone.

# --- Identity -----------------------------------------------------------
# Distinguishes this stack's containers, volumes and networks from other
# worktrees'. Takes precedence over the `name:` key in docker-compose.yml.
# Leave unset in the main clone to get the default `isoplus-portal`.
# COMPOSE_PROJECT_NAME=isoplus-feature-x

# --- App ports ----------------------------------------------------------
# Defaults avoid the agenticflo stack, which holds 3000 (via the crash-looping
# agenticflo-calls-api, which reclaims it every few seconds), 3001 and 6379.
# Worktrees get 3110/4011, 3120/4021, ... assigned by scripts/worktree.sh.
FRONTEND_PORT=3100
BACKEND_PORT=4001

# --- Shared infra ports -------------------------------------------------
# Read by docker-compose.infra.yml. There is only one infra stack per machine,
# so these are the same for every worktree; set them in the main clone.
MONGO_PORT=27017
REDIS_PORT=6380

# --- File watching (macOS / Windows) ------------------------------------
# Docker Desktop does not forward inotify events across bind mounts, so nodemon
# and Next dev never notice host edits and hot reload appears dead. Turn on
# polling there. It costs noticeable CPU, so leave it off on Linux, where
# native file events work.
# WATCH_POLLING=true
# WATCH_INTERVAL=1000

# --- Database -----------------------------------------------------------
# Every worktree shares one mongo container but may target its own database.
# `business-dashboard` is the name the app expects (see Backend/.env.example).
# scripts/worktree.sh --isolated-db sets this to business-dashboard-<worktree>.
# MONGO_DB=business-dashboard
