NEXT_PUBLIC_BACKEND_URL=your-backend-uri

# Optional: extra exact origins trusted for OAuth postMessage checks
# (comma/space separated). Must match scheme+host+port.
# NEXT_PUBLIC_TRUSTED_ORIGINS=https://portal.example.com

# Sentry browser logging. Leave empty to disable Sentry entirely.
# Full DSN from the Sentry project (Settings > Client Keys / DSN).
# Used for ISO+ OAuth redirect / ticket-exchange auth failure reporting.
NEXT_PUBLIC_SENTRY_DSN=

